# evidence-cmd: bash -c 'S=plugins/foundry/scripts/serena-daemon.sh; grep -q "<key>WorkingDirectory</key>" "$S" && echo PLIST_WORKINGDIR_OK; grep -q "WorkingDirectory=" "$S" && echo SYSTEMD_WORKINGDIR_OK; grep -q "Type=forking" "$S" && echo SYSTEMD_FORKING_OK; grep -q "PIDFile=%h/.serena-daemon.pid" "$S" && echo SYSTEMD_PIDFILE_OK; grep -Eq "ExecStart=.*serena-mcp" "$S" && echo EXECSTART_DIRECT_UVX || echo EXECSTART_ROUTED_VIA_SCRIPT; grep -q "serena_port_pids" "$S" && echo PORT_REAP_HELPER_OK; grep -q "kill -KILL" "$S" && echo SIGKILL_FALLBACK_OK'
# evidence-for: US-002, AC-005, AC-004
# Demonstrates the P002 grind-cycle fixes: D-003 (WorkingDirectory in both the
# launchd plist and the systemd unit), D-004 (systemd ExecStart routed through
# serena-daemon.sh via Type=forking + PIDFile; no longer direct uvx), and
# D-005 (port-based reap helper + SIGKILL fallback so stop kills the real
# serena-mcp process despite uvx PID indirection).

PLIST_WORKINGDIR_OK
SYSTEMD_WORKINGDIR_OK
SYSTEMD_FORKING_OK
SYSTEMD_PIDFILE_OK
EXECSTART_ROUTED_VIA_SCRIPT
PORT_REAP_HELPER_OK
SIGKILL_FALLBACK_OK
